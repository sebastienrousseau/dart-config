{
  "name": "@sebastienrousseau/dart-config",
  "version": "0.0.7",
  "description": "Shareable Dart / Flutter configuration providing standardized analysis options and linter rules adhering to modern 2026 standards.",
  "author": "Sebastien Rousseau <sebastienrousseau@users.noreply.github.com>",
  "license": "Apache-2.0 OR MIT",
  "homepage": "https://github.com/sebastienrousseau/dart-config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastienrousseau/dart-config.git"
  },
  "bugs": {
    "url": "https://github.com/sebastienrousseau/dart-config/issues"
  },
  "keywords": [
    "config",
    "dart-config",
    "dart",
    "flutter",
    "analysis-options",
    "linter",
    "config"
  ],
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    }
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.cjs",
    "index.d.ts",
    "analysis_options.yaml",
    "dart-config.svg",
    "LICENSE",
    ".editorconfig"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test tests/conformance.test.js tests/bench.test.js",
    "bench": "node benches/bench_load.js",
    "examples": "node examples/basic.js && node examples/advanced.js && node examples/features.js && node examples/esm.mjs",
    "docs:build": "bash scripts/build-docs.sh",
    "lint": "node test/test.js",
    "test:conformance": "node --test tests/conformance.test.js",
    "fuzz": "node fuzz/fuzz_config.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "sideEffects": false,
  "devDependencies": {
    "@sebastienrousseau/config-kit": "^0.0.8"
  },
  "configKit": {
    "shape": "object",
    "presets": [
      "analysis_options.yaml"
    ],
    "nativeToolchain": "dart analyze"
  }
}
